# Home Server Deployment Configuration
# Copy this file to .env.local and customize for your environment

# Repository settings
REPO_DIR=/opt/josephbaruch.com
REPO_URL=https://github.com/JosephPBaruch/joseph-baruch.com.git
BRANCH=main

# Docker settings
CONTAINER_NAME=josephbaruch-website
IMAGE_NAME=josephbaruch.com
PORT=8084

# Optional: Custom port mapping (if 8084 is already in use)
# HOST_PORT=8085
